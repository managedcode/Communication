<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <Title>ManagedCode.Communication.CQRS</Title>
        <PackageId>ManagedCode.Communication.CQRS</PackageId>
        <Description>Streaming CQRS primitives for ManagedCode.Communication: IAsyncEnumerable progress chunks and a Server-Sent Events HttpClient reader. Transport-agnostic, usable from any client (console, Blazor WASM, MAUI).</Description>
        <PackageTags>managedcode;communication;cqrs;sse;streaming;result-pattern</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ManagedCode.Communication\ManagedCode.Communication.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ManagedCode.Communication.CQRS.AspNetCore" />
        <InternalsVisibleTo Include="ManagedCode.Communication.Tests" />
    </ItemGroup>

</Project>
