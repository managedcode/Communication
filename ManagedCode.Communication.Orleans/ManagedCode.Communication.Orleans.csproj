<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <DebugType>embedded</DebugType>
        <RootNamespace>ManagedCode.Communication</RootNamespace>
    </PropertyGroup>

    <!--NuGet-->
    <PropertyGroup>
        <Title>ManagedCode.Communication.Orleans</Title>
        <PackageId>ManagedCode.Communication.Orleans</PackageId>
        <Description>Orleans serialization, filters, idempotency, and distributed command rate limiting for ManagedCode.Communication.</Description>
        <PackageTags>managedcode;communication;result;orleans;commands;idempotency;distributed-rate-limiting</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.3.1" />
        <PackageReference Include="Microsoft.Orleans.Runtime" Version="10.3.1" />
        <PackageReference Include="Microsoft.Orleans.Server" Version="10.3.1" />
        <PackageReference Include="Microsoft.Orleans.Persistence.Memory" Version="10.3.1" />
        <PackageReference Include="Microsoft.Orleans.Serialization.Abstractions" Version="10.2.2" />
        <PackageReference Include="ManagedCode.Orleans.RateLimiting.Server" Version="10.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ManagedCode.Communication\ManagedCode.Communication.csproj"/>
        <ProjectReference Include="..\ManagedCode.Communication.AspNetCore\ManagedCode.Communication.AspNetCore.csproj"/>
    </ItemGroup>

</Project>
